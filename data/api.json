  "notes": [
    {
      "level": "danger",
      "title": "mi_shutdown 会终止代码执行",
      "text": "理论上不应该被调用。调用后脚本直接中断，不是“先执行完再清理”。"
    },
    {
      "level": "warn",
      "title": "mmh / mmv 的方向是反的",
      "text": "名字里带 H 的（mmh、mouseMoveH）实际做垂直移动；带 V 的（mmv、mouseMoveV）实际做水平移动。照名字猜必错。"
    },
    {
      "level": "warn",
      "title": "两个退出检测默认关闭，且不传参等于开启",
      "text": "mi_setRoomTimeExit / mi_setDisconnectExit 运行时默认关闭。但 Lua 包装层的默认值是 1，所以不带参数调用 = 开启。要关就明确写 0。"
    },
    {
      "level": "warn",
      "title": "mi_target* 依赖 mi_getTarget 的缓存",
      "text": "mi_targetType / Count / Begin / Dist 读的都是上一次 mi_getTarget 或 mi_getSecondTarget 缓存下来的结果。顺序错了会拿到旧数据。"
    },
    {
      "level": "warn",
      "title": "kp 的末位数字可能被当成延时",
      "text": "最后一个数字 ≥10 就不当作按键，而是当作按住毫秒数。kp(65) 是延时 65ms，不是按 A。"
    },
    {
      "level": "warn",
      "title": "mi_lootCount 没就绪返回 -1，且没有超时",
      "text": "要先 mi_lootRequest 发起请求，再轮询 mi_lootCount。没有超时机制，必须自己在循环里加上限。"
    },
    {
      "level": "warn",
      "title": "mi_loadGraph 返回值个数不固定",
      "text": "成功只返回 1 个值，失败返回 2 个。用 local ok, err = mi_loadGraph() 接是安全的，但不要假设失败时也有 err。"
    },
    {
      "level": "info",
      "title": "mi_unload 未注册",
      "text": "调用得到 nil，不要用。"
    }
  ],
  "funcs": [
    {
      "name": "mi_start",
      "cat": "lifecycle",
      "sig": "mi_start()",
      "brief": "初始化运行环境并按默认值重置各项开关。",
      "params": [],
      "returns": "true；失败返回 false, \"fal N\"",
      "note": "每次都重置：脱困关、图模式关、房间/断线检测关，并写入一套默认键序（2 e 3 e 5 e 2 1，各 200ms）。 fal 1=环境初始化失败；fal 2=未加载组件数据；fal 3=加载失败；fal 4=解密失败。",
      "trap": false
    },
    {
      "name": "mi_shutdown",
      "cat": "lifecycle",
      "sig": "mi_shutdown()",
      "brief": "关闭运行组件并释放资源。",
      "params": [],
      "returns": "无",
      "note": "会终止后续代码执行，理论上不应被调用。",
      "trap": true
    },
    {
      "name": "mi_run",
      "cat": "lifecycle",
      "sig": "mi_run(path)",
      "brief": "按当前加成的配置初始化键序，然后执行指定 Lua 文件。",
      "params": [
        {
          "n": "path",
          "t": "string",
          "d": "要执行的 Lua 脚本路径，相对 exe 目录"
        }
      ],
      "returns": "true；失败返回 false, errmsg",
      "note": "执行前会按当前加成的键序配置自动套用 first / loop / boss 键序；找不到该加成则跳过配置直接执行文件。脚本报错时返回文件名和错误信息。",
      "trap": false
    },
